// Range entries: 4177 16-bit, 2714 32-bit, 6891 total.
// Range bytes: 25062 16-bit, 32568 32-bit, 57630 total.

// Fold orbit bytes: 88 pairs, 352 bytes
-- go-1.26.1/src/unicode/utf8/utf8.go --
