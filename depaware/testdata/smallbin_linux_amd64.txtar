	// Set in runtime.cpuinit.
	// TODO: deprecate these; use internal/cpu directly.
	x86HasAVX    bool
	x86HasFMA    bool
	x86HasPOPCNT bool
	x86HasSSE41  bool

	armHasVFPv4 bool

	arm64HasATOMICS bool

	loong64HasLAMCAS bool
	loong64HasLAM_BH bool
	loong64HasLSX    bool

